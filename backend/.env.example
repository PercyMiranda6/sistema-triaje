# ============================================================
# SISTEMA TRIALE - VARIABLES DE ENTORNO
# Copia este archivo a .env y completa tus valores
# ============================================================

# --- Servidor ---
PORT=4000
NODE_ENV=development
CORS_ORIGINS=https://sistema-triaje-frontend.onrender.com,http://localhost:4200,http://127.0.0.1:4200

# --- Seguridad (cambialo en produccion) ---
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# --- Base de datos MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sistema_triaje

# --- API de IA (usa al menos UNA de las dos) ---
# Groq (prioritario si existe): https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Usuarios iniciales del seed (configura credenciales privadas; no las subas al repositorio)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_CLIENTE_EMAIL=
SEED_CLIENTE_PASSWORD=
SEED_ANA_EMAIL=
SEED_ANA_PASSWORD=
SEED_CARLOS_EMAIL=
SEED_CARLOS_PASSWORD=
SEED_MARIA_EMAIL=
SEED_MARIA_PASSWORD=
SEED_LUIS_EMAIL=
SEED_LUIS_PASSWORD=
SEED_ROSA_EMAIL=
SEED_ROSA_PASSWORD=
